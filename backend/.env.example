# Copia este archivo como .env y ajusta los valores
DATABASE_URL="postgresql://tienda:tienda@localhost:5433/tienda?schema=public"
PORT=3000

# Autenticación — genera tu propio secreto: node -e "console.log(require('crypto').randomBytes(36).toString('hex'))"
JWT_SECRET="cambia-esto-por-un-secreto-largo"
# Access token de vida corta (regla: 15-60 min) + refresh token de larga vida
JWT_EXPIRES_IN="30m"
REFRESH_TTL_DAYS="30"

# Enlace que llega por correo para restablecer la contraseña.
# En desarrollo con Expo Go usa: exp://<IP-DE-TU-PC>:8081/--/reset-password
APP_RESET_URL="tiendaropa://reset-password"

# SMTP para enviar correos (opcional: si falta, el enlace se imprime en la consola del backend)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Shopping <no-reply@shopping.app>"

# Secreto para validar la firma HMAC-SHA256 del webhook de la pasarela de pagos
PAYMENT_WEBHOOK_SECRET="cambia-esto-por-un-secreto-largo"

# Correos con acceso al panel administrativo (separados por coma)
ADMIN_EMAILS="dueno@tutienda.com"

# Minutos que se mantiene reservado el inventario de una orden sin pagar
RESERVATION_MINUTES="15"
