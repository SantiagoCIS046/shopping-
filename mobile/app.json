{
  "expo": {
    "name": "Tienda Ropa",
    "slug": "tienda-ropa-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "tiendaropa",
    "splash": {
      "backgroundColor": "#050A16"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tuempresa.tiendaropa",
      "infoPlist": {
        "NSCameraUsageDescription": "Permite usar la cámara para probarte las prendas."
      }
    },
    "android": {
      "package": "com.tuempresa.tiendaropa",
      "adaptiveIcon": {
        "backgroundColor": "#050A16"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permite usar la cámara para probarte las prendas."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite elegir una foto para probarte las prendas."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-asset",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Permite usar la cámara para probarte las prendas.",
          "enableMicrophonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "27ff0cf3-cd6d-4700-a707-91cf1bec1525"
      }
    }
  }
}
